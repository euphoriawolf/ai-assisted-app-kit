---
import "@/styles/globals.css";
import { UserMenu } from "@/components/app/UserMenu";
import { Toaster } from "@/components/ui/sonner";
import { FEATURES } from "@app/shared/constants";

interface Props {
  title?: string;
  active?: "dashboard" | "new" | "billing";
}
const { title = "Dashboard", active } = Astro.props;

// Billing is optional — only surface it when enabled.
const nav = [
  { href: "/dashboard", label: "Dashboard", key: "dashboard" },
  { href: "/dashboard/new", label: "New item", key: "new" },
  ...(FEATURES.billing.enabled ? [{ href: "/dashboard/billing", label: "Billing", key: "billing" }] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="flex min-h-screen">
      <aside class="hidden w-[248px] shrink-0 flex-col bg-sidebar text-sidebar-foreground md:flex">
        <a href="/dashboard" class="flex h-14 items-center px-5 text-base font-semibold">Starter App</a>
        <nav class="flex-1 space-y-1 px-3">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class={`block rounded-md px-3 py-2 text-sm transition-colors ${
                  active === n.key
                    ? "bg-sidebar-accent text-sidebar-accent-foreground"
                    : "text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground"
                }`}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex h-14 items-center justify-between border-b border-border px-6">
          <h1 class="text-sm font-medium">{title}</h1>
          <UserMenu client:load />
        </header>
        <main class="flex-1 bg-surface-page p-6">
          <slot />
        </main>
      </div>
    </div>
    <Toaster client:load />
  </body>
</html>
