{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starterapp-web",
  "main": "dist/_worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Prod: serve the app on your domain. It should share the registrable domain with the API
  // (app.example.com + api.example.com) so the session cookie (COOKIE_DOMAIN=.example.com) is
  // first-party. Fill in the custom domain when you deploy.
  "routes": [{ "pattern": "REPLACE_WITH_YOUR_DOMAIN", "custom_domain": true }],

  "assets": { "directory": "./dist", "binding": "ASSETS" },

  // The Astro Cloudflare adapter uses a KV namespace named SESSION for its sessions feature.
  // Create one (`wrangler kv namespace create SESSION`) and paste the id. Unused if you rely
  // solely on the API's own session cookie, but the binding must exist to avoid a build warning.
  "kv_namespaces": [{ "binding": "SESSION", "id": "REPLACE_WITH_KV_ID" }],

  "vars": { "PUBLIC_API_BASE_URL": "https://api.example.com" },
  "env": {
    "dev": { "vars": { "PUBLIC_API_BASE_URL": "http://localhost:8787" } }
  }
}
